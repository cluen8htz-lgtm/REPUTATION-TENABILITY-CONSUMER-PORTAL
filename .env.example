# ── Core (required in production) ───────────────────────────────
APP_SECRET=                 # 32+ random bytes; signs session cookies (openssl rand -base64 48)
DATABASE_URL=               # mysql://user:pass@host:3306/reputation_tenability
PUBLIC_URL=                 # https://portal.example.com (optional, used in links)

# ── Accounts ────────────────────────────────────────────────────
OWNER_EMAIL=                # comma-separated emails that become staff (admin); these may always self-register
ALLOW_REGISTRATION=false    # invitation-only: staff create accounts under Staff review → Clients

# ── AI (Claude) — optional; rule engine + templates work without it ──
ANTHROPIC_API_KEY=          # enables statement reading, letter polishing, response classification
ANTHROPIC_MODEL=claude-opus-5-5
AI_DISABLED=false

# ── Private file storage ────────────────────────────────────────
STORAGE_DRIVER=             # local | s3 | kimi   (auto: s3 if S3_BUCKET, kimi if platform keys, else local)
STORAGE_DIR=./.data/uploads # local driver only
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=                # set for R2 / MinIO; AWS credentials come from the standard AWS env/role

# ── Optional legacy Kimi OAuth sign-in ──────────────────────────
APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
VITE_KIMI_AUTH_URL=
VITE_APP_ID=
OWNER_UNION_ID=
